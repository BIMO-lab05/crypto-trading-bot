*~
.DS_Store

# Claude Code (personal local overrides only — settings.json + scripts are committed)
.claude/settings.local.json

# ============================================================================
# SECURITY: Environment and Secrets (CRITICAL - Never commit credentials)
# ============================================================================
.env
.env.local
.env.*.local
.env.development
.env.staging
.env.production
# Test-mode environment override (gitignored — may contain real test bot creds)
.env.test
*.secret
*.secrets
secrets/
credentials.json
bybit_api_keys.txt

# Kubernetes secrets (SECURITY: Only template files should be committed)
# Pattern: Ignore all secrets files, except templates
**/secrets.yaml
**/secrets-*.yaml
*-secrets.yaml
*-secrets-*.yaml
!**/*-template.yaml
!**/secrets-template.yaml

# Explicit paths for staging/production secrets
infrastructure/kubernetes/staging/secrets.yaml
infrastructure/kubernetes/production/secrets.yaml
infrastructure/kubernetes/*/secrets.yaml
!infrastructure/kubernetes/*/secrets-template.yaml

# Sealed secrets (encrypted - safe to commit, but explicit ignore for safety)
# Uncomment the following line if using sealed-secrets and want to track them:
# !**/sealed-secrets.yaml

# Private keys and certificates
*.pem
*.key
*.p12
*.pfx
*.crt
!*.crt.example

# API keys and tokens
*.apikey
*.token
api_keys.json
tokens.json

