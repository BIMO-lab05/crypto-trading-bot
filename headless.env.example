# =============================================================================
# Headless deploy env template (Oracle Cloud / any single-host Linux)
# =============================================================================
# Copy to .env on the deploy host: `cp headless.env.example .env && chmod 600 .env`
# .env is gitignored — never commit real values.
# =============================================================================

# --- Bybit (mainnet prices, paper-traded orders) ---
# Paper-trading flags MUST both be set. Real-money trading needs the
# explicit three-flag flip (see CLAUDE.md): PAPER_TRADING_MODE=false,
# TRADING_MODE=LIVE, plus mainnet keys with trading permissions.
BYBIT_API_KEY=
BYBIT_API_SECRET=
BYBIT_TESTNET=false
PAPER_TRADING_MODE=true
TRADING_MODE=PAPER
PAPER_INITIAL_BALANCE=100.0

# --- Risk caps (do not relax without approval — CLAUDE.md) ---
MAX_RISK_PER_TRADE=0.02
EMERGENCY_STOP_LOSS=0.05
EMERGENCY_STOP_FILE=/app/EMERGENCY_STOP

# --- Strategy ---
STRATEGY_MODE=ensemble

# --- Logging ---
LOG_LEVEL=INFO

# --- Postgres (application state) ---
POSTGRES_USER=cryptobot
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM_STRING
POSTGRES_DB=cryptobot

# --- TimescaleDB (market data) ---
TIMESCALE_USER=cryptobot
TIMESCALE_PASSWORD=CHANGE_ME_LONG_RANDOM_STRING
TIMESCALE_DB=market_data

# --- Redis ---
REDIS_PASSWORD=CHANGE_ME_LONG_RANDOM_STRING

# --- Disabled services in headless deploy (kept for reference) ---
# RABBITMQ_*    not used (broker dropped)
# NEWS_API_KEY  sentiment service dropped
# TWITTER_BEARER_TOKEN  sentiment service dropped
# Telegram/Slack/SMTP   notification service dropped — re-add if you re-enable it
