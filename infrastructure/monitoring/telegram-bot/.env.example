# Telegram Bot Configuration
# Copy this file to .env and fill in your values

# Get this from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz

# Your Telegram chat ID (use /get-chat-id endpoint to find it)
TELEGRAM_CHAT_ID=987654321

# Port for webhook server
TELEGRAM_WEBHOOK_PORT=8007

# Webhook authentication token (change this!)
WEBHOOK_TOKEN=change-this-to-a-secure-random-token

# SMTP Configuration for Email Alerts
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-specific-password

# Alert email recipient
ALERT_EMAIL=alerts@yourdomain.com

# Optional: Slack webhooks
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
SLACK_WEBHOOK_URL_CRITICAL=https://hooks.slack.com/services/YOUR/CRITICAL/URL
SLACK_WEBHOOK_URL_DATABASE=https://hooks.slack.com/services/YOUR/DATABASE/URL

# Optional: PagerDuty
PAGERDUTY_SERVICE_KEY=your-pagerduty-service-key
