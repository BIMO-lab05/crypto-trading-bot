# ============================================================================
# CRYPTO TRADING BOT - ENVIRONMENT CONFIGURATION TEMPLATE
# ============================================================================
# SECURITY NOTICE:
# - Copy this file to .env and fill in your actual values
# - NEVER commit .env file to git (it contains sensitive credentials)
# - Use strong, randomly generated passwords (32+ characters)
# - Rotate credentials regularly
# - Use secrets management in production (e.g., HashiCorp Vault, AWS Secrets Manager)
#
# Generate secure passwords with:
#   openssl rand -base64 32
#   openssl rand -hex 32
# ============================================================================

# ----------------------------------------------------------------------------
# ENVIRONMENT
# ----------------------------------------------------------------------------
ENVIRONMENT=development  # development, staging, production
LOG_LEVEL=DEBUG          # DEBUG, INFO, WARNING, ERROR, CRITICAL
DEBUG=true

# ----------------------------------------------------------------------------
# BYBIT API CONFIGURATION
# ----------------------------------------------------------------------------
# Get API keys from: https://testnet.bybit.com/ (for testing)
# Production: https://www.bybit.com/ (after thorough testing only!)
#
# SECURITY:
# - Never share API keys
# - Use IP whitelisting on Bybit
# - Enable 2FA on your Bybit account
# - Use separate keys for testnet and production

BYBIT_API_KEY=<your_bybit_api_key_here>
BYBIT_API_SECRET=<your_bybit_api_secret_here>
BYBIT_TESTNET=true  # true for testnet, false for production (BE CAREFUL!)
BYBIT_RECV_WINDOW=5000  # API request validity window (milliseconds)

# ----------------------------------------------------------------------------
# DATABASE - POSTGRESQL (Application Database)
# ----------------------------------------------------------------------------
# Generate secure password: openssl rand -base64 32
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=cryptobot
POSTGRES_PASSWORD=<generate_with_openssl_rand_base64_32>
POSTGRES_DB=cryptobot

# Connection pool settings
POSTGRES_POOL_MIN_SIZE=10
POSTGRES_POOL_MAX_SIZE=20

# Database URL (auto-constructed, but can override)
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# ----------------------------------------------------------------------------
# DATABASE - TIMESCALEDB (Market Data Time-Series)
# ----------------------------------------------------------------------------
# Generate secure password: openssl rand -base64 32
TIMESCALE_HOST=localhost
TIMESCALE_PORT=5433
TIMESCALE_USER=cryptobot
TIMESCALE_PASSWORD=<generate_with_openssl_rand_base64_32>
TIMESCALE_DB=market_data

# TimescaleDB URL
TIMESCALE_URL=postgresql://${TIMESCALE_USER}:${TIMESCALE_PASSWORD}@${TIMESCALE_HOST}:${TIMESCALE_PORT}/${TIMESCALE_DB}

# ----------------------------------------------------------------------------
# REDIS (Caching & Session Storage)
# ----------------------------------------------------------------------------
# Generate secure password: openssl rand -base64 32
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=<generate_with_openssl_rand_base64_32>
REDIS_DB=0
REDIS_MAX_CONNECTIONS=50

# Redis URL
REDIS_URL=redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}/${REDIS_DB}

# ----------------------------------------------------------------------------
# RABBITMQ (Message Broker)
# ----------------------------------------------------------------------------
# Generate secure password: openssl rand -base64 32
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=cryptobot
RABBITMQ_PASSWORD=<generate_with_openssl_rand_base64_32>
RABBITMQ_VHOST=cryptobot

# RabbitMQ URL
RABBITMQ_URL=amqp://${RABBITMQ_USER}:${RABBITMQ_PASSWORD}@${RABBITMQ_HOST}:${RABBITMQ_PORT}/${RABBITMQ_VHOST}

# ----------------------------------------------------------------------------
# SERVICE PORTS (must match docker-compose.yml)
# ----------------------------------------------------------------------------
API_GATEWAY_PORT=8000
BYBIT_CONNECTOR_PORT=8001
MARKET_DATA_SERVICE_PORT=8002
PORTFOLIO_MANAGER_PORT=8003
TECHNICAL_ANALYSIS_PORT=8004
TRADING_ENGINE_PORT=8005
NOTIFICATION_SERVICE_PORT=8006
ML_PREDICTION_PORT=8007
SENTIMENT_ANALYSIS_PORT=8008
RISK_METRICS_PORT=8009

# ----------------------------------------------------------------------------
# TRADING CONFIGURATION
# ----------------------------------------------------------------------------
# Initial Trading Mode (PAPER or LIVE - start with PAPER!)
TRADING_MODE=PAPER

# Trading Pairs (comma-separated)
TRADING_PAIRS=BTCUSDT,ETHUSDT

# Default trading pair
DEFAULT_PAIR=BTCUSDT

# ----------------------------------------------------------------------------
# RISK MANAGEMENT
# ----------------------------------------------------------------------------
# Maximum risk per single trade (as decimal, e.g., 0.02 = 2%)
MAX_RISK_PER_TRADE=0.02

# Maximum daily loss before emergency stop (as decimal, e.g., 0.05 = 5%)
MAX_DAILY_LOSS=0.05

# Maximum position size as % of portfolio (as decimal)
MAX_POSITION_SIZE=0.10

# Stop loss percentage (as decimal)
STOP_LOSS_PERCENTAGE=0.03

# Take profit percentage (as decimal)
TAKE_PROFIT_PERCENTAGE=0.06

# Maximum number of concurrent positions
MAX_CONCURRENT_POSITIONS=3

# Minimum order size (USDT)
MIN_ORDER_SIZE=10.0

# ----------------------------------------------------------------------------
# PAPER TRADING (Simulation)
# ----------------------------------------------------------------------------
# Initial balance for paper trading (USDT)
PAPER_TRADING_INITIAL_BALANCE=10000.0

# Paper trading reset on startup
PAPER_TRADING_RESET=false

# ----------------------------------------------------------------------------
# TECHNICAL ANALYSIS
# ----------------------------------------------------------------------------
# Default candlestick interval for analysis
DEFAULT_CANDLE_INTERVAL=1h

# RSI Settings
RSI_PERIOD=14
RSI_OVERBOUGHT=70
RSI_OVERSOLD=30

# MACD Settings
MACD_FAST_PERIOD=12
MACD_SLOW_PERIOD=26
MACD_SIGNAL_PERIOD=9

# Bollinger Bands Settings
BOLLINGER_PERIOD=20
BOLLINGER_STD_DEV=2

# Moving Average Periods
SMA_SHORT_PERIOD=10
SMA_LONG_PERIOD=50
EMA_PERIOD=20

# ----------------------------------------------------------------------------
# CACHING
# ----------------------------------------------------------------------------
# Cache TTL for market data (seconds)
MARKET_DATA_CACHE_TTL=60

# Cache TTL for technical indicators (seconds)
INDICATOR_CACHE_TTL=300

# Cache TTL for balance/position data (seconds)
PORTFOLIO_CACHE_TTL=30

# ----------------------------------------------------------------------------
# RATE LIMITING
# ----------------------------------------------------------------------------
# Bybit API rate limits (requests per minute)
BYBIT_API_RATE_LIMIT=120

# Internal API rate limits
API_RATE_LIMIT_PER_MINUTE=100

# ----------------------------------------------------------------------------
# WEBSOCKET
# ----------------------------------------------------------------------------
# WebSocket reconnect settings
WS_RECONNECT_DELAY=5
WS_MAX_RECONNECT_ATTEMPTS=10
WS_PING_INTERVAL=20
WS_PING_TIMEOUT=10

# ----------------------------------------------------------------------------
# NOTIFICATIONS (Optional - Configure later)
# ----------------------------------------------------------------------------
# Email notifications
ENABLE_EMAIL_NOTIFICATIONS=false
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_FROM=<your_email@gmail.com>
EMAIL_PASSWORD=<your_app_password>
EMAIL_TO=<your_email@gmail.com>

# Telegram notifications
ENABLE_TELEGRAM_NOTIFICATIONS=false
TELEGRAM_BOT_TOKEN=<your_telegram_bot_token>
TELEGRAM_CHAT_ID=<your_telegram_chat_id>

# ----------------------------------------------------------------------------
# MONITORING & METRICS
# ----------------------------------------------------------------------------
# Prometheus metrics
ENABLE_METRICS=true
METRICS_PORT=9090

# Health check interval (seconds)
HEALTH_CHECK_INTERVAL=30

# ----------------------------------------------------------------------------
# SECURITY - CRITICAL SETTINGS
# ----------------------------------------------------------------------------
# JWT Secret Key - REQUIRED for production/staging
# Generate with: openssl rand -hex 64
# MUST be at least 32 characters in production
# Application will FAIL TO START in production without this set
JWT_SECRET_KEY=<generate_with_openssl_rand_hex_64>

# JWT Algorithm (HS256 recommended for single-service, RS256 for multi-service)
JWT_ALGORITHM=HS256

# Token expiration in minutes (30 recommended, use refresh tokens for longer sessions)
ACCESS_TOKEN_EXPIRE_MINUTES=30

# API Key for service-to-service communication
# Generate with: openssl rand -hex 32
INTERNAL_API_KEY=<generate_with_openssl_rand_hex_32>

# CORS allowed origins (comma-separated, use specific domains in production)
# NEVER use * in production
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# ----------------------------------------------------------------------------
# DATA RETENTION
# ----------------------------------------------------------------------------
# How long to keep tick data (days)
TICK_DATA_RETENTION_DAYS=90

# How long to keep orderbook snapshots (days)
ORDERBOOK_RETENTION_DAYS=30

# How long to keep audit logs (days)
AUDIT_LOG_RETENTION_DAYS=365

# ----------------------------------------------------------------------------
# PERFORMANCE
# ----------------------------------------------------------------------------
# Number of worker processes (per service)
WORKERS=4

# Request timeout (seconds)
REQUEST_TIMEOUT=30

# Database connection timeout (seconds)
DB_CONNECTION_TIMEOUT=10

# ----------------------------------------------------------------------------
# BACKTEST (Future Feature)
# ----------------------------------------------------------------------------
BACKTEST_START_DATE=2024-01-01
BACKTEST_END_DATE=2024-12-31
BACKTEST_INITIAL_CAPITAL=10000.0

# ----------------------------------------------------------------------------
# FEATURE FLAGS
# ----------------------------------------------------------------------------
# Enable specific features (true/false)
ENABLE_WEBSOCKET_STREAMING=true
ENABLE_AUTOMATIC_TRADING=false  # Start with false, enable after testing
ENABLE_PORTFOLIO_REBALANCING=false
ENABLE_ADVANCED_INDICATORS=true
ENABLE_ML_PREDICTIONS=false  # Future feature

# ----------------------------------------------------------------------------
# DEVELOPMENT TOOLS (Development only - NEVER use in production)
# ----------------------------------------------------------------------------
# PgAdmin - CHANGE THESE IN PRODUCTION
PGADMIN_EMAIL=admin@cryptobot.local
PGADMIN_PASSWORD=<generate_secure_password>

# Auto-reload on code changes
AUTO_RELOAD=true

# SQL query logging
SQL_ECHO=false

# ============================================================================
# SECURITY CHECKLIST BEFORE DEPLOYMENT
# ============================================================================
# [ ] All <placeholder> values replaced with real, secure values
# [ ] Passwords are at least 32 characters, randomly generated
# [ ] JWT_SECRET_KEY is at least 64 hex characters
# [ ] ENVIRONMENT is set correctly (staging/production)
# [ ] DEBUG is set to false for production
# [ ] CORS_ORIGINS contains only specific domains
# [ ] BYBIT_TESTNET is false only after thorough testing
# [ ] TRADING_MODE is LIVE only after paper trading validation
# [ ] API keys have appropriate IP restrictions
# [ ] 2FA is enabled on all exchange accounts
# [ ] Secrets are stored in a secrets manager for production
# [ ] .env file is in .gitignore and not committed
# ============================================================================
