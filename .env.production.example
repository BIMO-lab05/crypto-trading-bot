# Production Environment Configuration
# Crypto Trading Bot - Microservices Architecture
# Copy this file to .env.production and fill in the values

# ============================================================================
# DEPLOYMENT CONFIGURATION
# ============================================================================
ENVIRONMENT=production
VERSION=latest
REGISTRY=localhost:5000

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
# PostgreSQL - Primary Database
DB_NAME=cryptobot
DB_USER=cryptobot
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE
DB_HOST=postgres
DB_PORT=5432

# TimescaleDB - Time-Series Database
TIMESCALE_DB=marketdata
TIMESCALE_USER=cryptobot
TIMESCALE_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE
TIMESCALE_HOST=timescaledb
TIMESCALE_PORT=5432

# ============================================================================
# CACHE AND MESSAGE BROKER
# ============================================================================
# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE

# RabbitMQ
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=cryptobot
RABBITMQ_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE

# ============================================================================
# APPLICATION SECURITY
# ============================================================================
# JWT Secret Key (generate with: openssl rand -hex 32)
SECRET_KEY=CHANGE_ME_GENERATE_RANDOM_KEY_HERE

# Allowed CORS Origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com

# ============================================================================
# BYBIT EXCHANGE API
# ============================================================================
# Bybit API Credentials
BYBIT_API_KEY=YOUR_BYBIT_API_KEY
BYBIT_API_SECRET=YOUR_BYBIT_API_SECRET
BYBIT_TESTNET=true  # Set to false for production trading

# ============================================================================
# TRADING CONFIGURATION
# ============================================================================
# Risk Management
PAPER_TRADING_MODE=true  # Set to false for live trading
MAX_RISK_PER_TRADE=0.02  # 2% max risk per trade
EMERGENCY_STOP_LOSS=0.05  # 5% daily loss emergency stop

# Trading Pairs (comma-separated)
TRADING_PAIRS=BTCUSDT,ETHUSDT,SOLUSDT

# ============================================================================
# NOTIFICATION SERVICES
# ============================================================================
# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-specific-password

# Telegram Bot
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
TELEGRAM_CHAT_ID=YOUR_TELEGRAM_CHAT_ID

# ============================================================================
# EXTERNAL APIs
# ============================================================================
# News API for sentiment analysis
NEWS_API_KEY=YOUR_NEWS_API_KEY

# Twitter/X API for sentiment analysis
TWITTER_BEARER_TOKEN=YOUR_TWITTER_BEARER_TOKEN

# ============================================================================
# MONITORING AND LOGGING
# ============================================================================
# Logging Level
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL

# Sentry (Error Tracking)
SENTRY_DSN=YOUR_SENTRY_DSN_HERE

# ============================================================================
# RESOURCE LIMITS
# ============================================================================
# Docker resource limits are defined in docker-compose.prod.yml
# Adjust based on your server capacity

# ============================================================================
# BACKUP AND RECOVERY
# ============================================================================
# Backup location
BACKUP_PATH=/backups
BACKUP_RETENTION_DAYS=30

# ============================================================================
# FEATURE FLAGS
# ============================================================================
ENABLE_ML_PREDICTIONS=true
ENABLE_SENTIMENT_ANALYSIS=true
ENABLE_PORTFOLIO_OPTIMIZATION=true
ENABLE_RISK_METRICS=true
