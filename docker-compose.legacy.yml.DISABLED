services:
  # API Gateway - Entry point for all requests
  api-gateway:
    build:
      context: ./services/api-gateway
      dockerfile: Dockerfile
    container_name: crypto-bot-api-gateway
    ports:
      - "8000:8000"
    env_file:
      - ./services/api-gateway/.env
    environment:
      - DEBUG=false
      - LOG_LEVEL=INFO
      - ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
      - TIMESCALE_HOST=crypto-bot-timescaledb
      - POSTGRES_HOST=crypto-bot-postgres
      - REDIS_HOST=crypto-bot-redis
      - RABBITMQ_HOST=crypto-bot-rabbitmq
      - BYBIT_CONNECTOR_URL=http://bybit-connector:8001
      - MARKET_DATA_URL=http://market-data:8002
      - PORTFOLIO_MANAGER_URL=http://portfolio-manager:8003
      - TECHNICAL_ANALYSIS_URL=http://technical-analysis:8004
      - TRADING_ENGINE_URL=http://trading-engine:8005
      - NOTIFICATION_URL=http://notification-service:8006
      - ML_PREDICTION_URL=http://ml-prediction:8007
      - SENTIMENT_ANALYSIS_URL=http://sentiment-analysis:8008
      - RISK_METRICS_URL=http://risk-metrics:8009
    volumes:
      - ./services/api-gateway/logs:/app/logs
    restart: unless-stopped
    networks:
      - crypto-bot-network
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:8000/health"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 40s
    deploy:
      resources:
        limits:
          cpus: '1.0'
          memory: 512M
        reservations:
          cpus: '0.25'
          memory: 128M

  # Frontend - React dashboard for monitoring and control
  frontend:
    build:
      context: ./frontend
      dockerfile: Dockerfile
    container_name: crypto-bot-frontend
    ports:
      - "3000:80"
    environment:
      - REACT_APP_API_URL=http://api-gateway:8000
    restart: unless-stopped
    networks:
      - crypto-bot-network
    depends_on:
      api-gateway:
        condition: service_healthy
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost/health"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 40s
    deploy:
      resources:
        limits:
          cpus: '0.5'
          memory: 256M
        reservations:
          cpus: '0.1'
          memory: 64M

  # Bybit Connector - Exchange API integration
  bybit-connector:
    build:
      context: ./services/bybit-connector
      dockerfile: Dockerfile
    container_name: crypto-bot-bybit
    ports:
      - "8001:8001"
    env_file:
      - ./services/bybit-connector/.env
    environment:
      - DEBUG=false
      - LOG_LEVEL=INFO
    volumes:
      - ./services/bybit-connector/logs:/app/logs
    restart: unless-stopped
    networks:
      - crypto-bot-network
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:8001/health"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 40s
    deploy:
      resources:
        limits:
          cpus: '0.5'
          memory: 512M
        reservations:
          cpus: '0.1'
          memory: 128M

  # Market Data Service - Real-time market data collection
  market-data:
    build:
      context: ./services/market-data-service
      dockerfile: Dockerfile
    container_name: crypto-bot-market-data
    ports:
      - "8002:8002"
    env_file:
      - ./services/market-data-service/.env
    environment:
      - DEBUG=false
      - LOG_LEVEL=INFO
      - SERVICE_PORT=8002
      - TIMESCALE_HOST=crypto-bot-timescaledb
      - POSTGRES_HOST=crypto-bot-postgres
      - REDIS_HOST=crypto-bot-redis
      - REDIS_PASSWORD=redis_dev_password
      - RABBITMQ_HOST=crypto-bot-rabbitmq
      - BYBIT_CONNECTOR_URL=http://bybit-connector:8001
      # 14 verified symbols (2025-12-03) - Only pairs with complete historical data
      # Removed 21 symbols: XRPUSDT,MATICUSDT,UNIUSDT,ATOMUSDT,NEARUSDT,ICPUSDT,FILUSDT,AAVEUSDT,MKRUSDT,INJUSDT,SEIUSDT,TIAUSDT,IMXUSDT,STXUSDT,RNDRUSDT,PENDLEUSDT,WLDUSDT,FTMUSDT,ALGOUSDT,SHIBUSDT,PEPEUSDT
      - DEFAULT_SYMBOLS=BTCUSDT,ETHUSDT,BNBUSDT,SOLUSDT,ADAUSDT,DOGEUSDT,AVAXUSDT,DOTUSDT,LINKUSDT,LTCUSDT,ARBUSDT,OPUSDT,APTUSDT,SUIUSDT
    volumes:
      - ./services/market-data-service/logs:/app/logs
    restart: unless-stopped
    networks:
      - crypto-bot-network
    depends_on:
      bybit-connector:
        condition: service_healthy
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:8002/health"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 40s
    deploy:
      resources:
        limits:
          cpus: '1.0'
          memory: 1G
        reservations:
          cpus: '0.25'
          memory: 256M

  # Portfolio Manager - Balance and position tracking
  portfolio-manager:
    build:
      context: ./services/portfolio-manager
      dockerfile: Dockerfile
    container_name: crypto-bot-portfolio
    ports:
      - "8003:8003"
    env_file:
      - ./services/portfolio-manager/.env
    environment:
      - DEBUG=false
      - LOG_LEVEL=INFO
      - TIMESCALE_HOST=crypto-bot-timescaledb
      - POSTGRES_HOST=crypto-bot-postgres
      - REDIS_HOST=crypto-bot-redis
      - RABBITMQ_HOST=crypto-bot-rabbitmq
      - BYBIT_CONNECTOR_URL=http://bybit-connector:8001
      - USE_DATABASE=false
      - DATABASE_URL=postgresql://cryptobot:cryptobot_dev_password@crypto-bot-postgres:5432/cryptobot
      - DB_HOST=crypto-bot-postgres
      - DB_PORT=5432
      - DB_NAME=cryptobot
      - DB_USER=cryptobot
      - DB_PASSWORD=cryptobot_dev_password
    volumes:
      - ./services/portfolio-manager/logs:/app/logs
    restart: unless-stopped
    networks:
      - crypto-bot-network
    depends_on:
      bybit-connector:
        condition: service_healthy
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:8003/health"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 40s
    deploy:
      resources:
        limits:
          cpus: '0.5'
          memory: 512M
        reservations:
          cpus: '0.1'
          memory: 128M

  # Technical Analysis - Trading indicators
  technical-analysis:
    build:
      context: ./services/technical-analysis
      dockerfile: Dockerfile
    container_name: crypto-bot-ta
    ports:
      - "8004:8004"
    env_file:
      - ./services/technical-analysis/.env
    environment:
      - DEBUG=false
      - LOG_LEVEL=INFO
      - TIMESCALE_HOST=crypto-bot-timescaledb
      - POSTGRES_HOST=crypto-bot-postgres
      - REDIS_HOST=crypto-bot-redis
      - RABBITMQ_HOST=crypto-bot-rabbitmq
      - BYBIT_CONNECTOR_URL=http://bybit-connector:8001
      - MARKET_DATA_URL=http://market-data:8002
    # Dev: Override command to use --reload for hot-reloading code changes
    command: ["python", "-m", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8004", "--reload"]
    volumes:
      - ./services/technical-analysis/logs:/app/logs
      - ./services/technical-analysis/app:/app/app  # Dev: source code mount
    restart: unless-stopped
    networks:
      - crypto-bot-network
    depends_on:
      bybit-connector:
        condition: service_healthy
      market-data:
        condition: service_healthy
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:8004/health"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 40s
    deploy:
      resources:
        limits:
          cpus: '1.0'
          memory: 1G
        reservations:
          cpus: '0.25'
          memory: 256M

  # Trading Engine - Core trading logic with SQZMOM Paper Trading
  trading-engine:
    build:
      context: ./services/trading-engine
      dockerfile: Dockerfile
    container_name: crypto-bot-trading
    ports:
      - "8005:8005"
    env_file:
      - ./services/trading-engine/.env
    environment:
      - DEBUG=false
      - LOG_LEVEL=INFO
      - TIMESCALE_HOST=crypto-bot-timescaledb
      - POSTGRES_HOST=crypto-bot-postgres
      - REDIS_HOST=crypto-bot-redis
      - RABBITMQ_HOST=crypto-bot-rabbitmq
      # Strategy Mode - HYBRID for dual confirmation (2026-02-17)
      - STRATEGY_MODE=hybrid
      # Risk Management
      - MAX_RISK_PER_TRADE=0.05  # 5% of $100 = $5 max risk per trade (2026-01-17)
      - EMERGENCY_STOP_LOSS=0.05
      # Paper Trading Mode - ENFORCED
      - PAPER_TRADING_MODE=true
      - TRADING_MODE=PAPER
      - PAPER_INITIAL_BALANCE=100.0
      - PAPER_COMMISSION_PCT=0.1
      # SQZMOM Strategy Configuration - Top 3 Performers (UPDATED 2025-12-13)
      - DEFAULT_STRATEGY=sqzmom
      - SQZMOM_ENABLED=true
      - STAT_ARB_ENABLED=false
      - GRID_TRADING_ENABLED=false
      - TREND_FOLLOWING_ENABLED=false
      - MOMENTUM_ENABLED=false
      - CONSENSUS_STRATEGY_ENABLED=false
      # Trading Symbols - OPTIMIZED TO 5 TIER 1 SYMBOLS (2026-01-19)
      # Focus on symbols with excellent historical data (250+ days, 60k+ candles)
      # Removed: DOT, ARB, OP (41 days), AVAX, LINK (64-70 days), MATIC (quality issues)
      - TRADING_SYMBOLS=["BTCUSDT","ETHUSDT","SOLUSDT","BNBUSDT","ADAUSDT"]
      - DEFAULT_SYMBOL=SOLUSDT
      - DEFAULT_INTERVAL=60  # Optimal 60m interval for quality signals
      # BACKTEST-OPTIMIZED ALLOCATIONS (2026-01-19) - Based on 30d/90d performance
      # SOL 30% (best), BTC 25% (leader), BNB 20%, ADA 15% (2nd best), ETH 10% (worst)
      - SYMBOL_ALLOCATIONS={"SOLUSDT":0.30,"BTCUSDT":0.25,"BNBUSDT":0.20,"ADAUSDT":0.15,"ETHUSDT":0.10}
      # Trading Hours - EXTENDED TO 01:00-21:00 UTC (2026-01-19)
      # Captures 01:00 Asia/Europe overlap (100% WR) and 17:00 London/NY overlap
      - TRADING_START_HOUR_UTC=1
      - TRADING_END_HOUR_UTC=21
      # SHORT TRADING - OPTION C: HYBRID CIRCUIT BREAKER (2026-01-19)
      # Re-enabled after backtest analysis showing +2-4% monthly profit potential
      - SHORT_TRADING_ENABLED=true
      - ALLOWED_TRADE_SIDES=["LONG","SHORT"]
      # SHORT Risk Controls - TIGHTER THAN LONG (2026-01-19)
      - SHORT_STOP_LOSS_PCT=1.5     # vs 2.0 for LONG (25% tighter)
      - SHORT_MIN_CONFIDENCE=0.70   # vs 0.65 for LONG (higher bar)
      - SHORT_MAX_POSITION_PCT=3.0  # vs 5.0 for LONG (40% smaller)
      # Circuit Breaker - Automatic SHORT Safety Shutdown (2026-01-19)
      - CIRCUIT_BREAKER_ENABLED=true
      - CIRCUIT_BREAKER_MAX_CONSECUTIVE_LOSSES=3
      - CIRCUIT_BREAKER_MAX_DRAWDOWN_PCT=10.0
      - CIRCUIT_BREAKER_MIN_WIN_RATE_PCT=45.0
      - CIRCUIT_BREAKER_EVALUATION_TRADES=30
      - CIRCUIT_BREAKER_CHECK_INTERVAL_MINUTES=60
      # Leverage Configuration - 10x ENABLED (2025-12-17)
      - LEVERAGE_ENABLED=true
      - DEFAULT_LEVERAGE=10.0
      - MAX_LEVERAGE=10.0
      - MIN_LEVERAGE=1.0
      # Risk Parameters - RESEARCH-OPTIMIZED (2025-12-21)
      - MAX_POSITION_SIZE_PCT=8.0
      - MAX_DAILY_LOSS_PCT=5.0
      - MAX_TOTAL_EXPOSURE_PCT=70.0
      - DEFAULT_STOP_LOSS_PCT=3.0
      - DEFAULT_TAKE_PROFIT_PCT=9.0
      # Dynamic Risk Budgeting
      - ENABLE_DYNAMIC_RISK_BUDGETING=true
      - RISK_BUDGET_INITIAL=100.0
      - RISK_BUDGET_DAILY_RESET=true
      - RISK_SCALING_FACTOR=0.5
      - MAX_RISK_MULTIPLIER=2.0
      - MIN_RISK_MULTIPLIER=0.25
      # Signal Thresholds - RESEARCH-BACKED (3 indicators, 65%+ confidence professional standard)
      - MIN_SIGNAL_CONFIDENCE=0.55  # LOWERED: From 0.65 to 0.55 for more trading opportunities (2026-01-17)
      - MIN_CONSENSUS_INDICATORS=3
      # Service URLs
      - BYBIT_CONNECTOR_URL=http://bybit-connector:8001
      - MARKET_DATA_URL=http://market-data:8002
      - PORTFOLIO_MANAGER_URL=http://portfolio-manager:8003
      - TECHNICAL_ANALYSIS_URL=http://technical-analysis:8004
      - ML_PREDICTION_URL=http://ml-prediction:8007
      - SENTIMENT_ANALYSIS_URL=http://sentiment-analysis:8008
      - NOTIFICATION_SERVICE_URL=http://notification-service:8006
      # ML/Sentiment disabled for SQZMOM isolation
      - ENABLE_ML_PREDICTIONS=false
      - ENABLE_SENTIMENT_ANALYSIS=false
      - ENABLE_MULTI_TIMEFRAME=false
      # Trade frequency
      - MAX_DAILY_TRADES=50
      - CHECK_FREQUENCY_SECONDS=30
      - ALLOW_SAME_SYMBOL_REENTRY=true
      - MIN_TIME_BETWEEN_TRADES_SAME_SYMBOL=60
      # Notifications
      - ENABLE_NOTIFICATIONS=true
      - NOTIFY_ON_TRADE_OPEN=true
      - NOTIFY_ON_TRADE_CLOSE=true
      - NOTIFY_ON_DAILY_SUMMARY=true
      # Time filters
      - ENABLE_TIME_FILTERS=true
      - AVOID_WEEKENDS=true
    # Dev: Override command to use --reload for hot-reloading code changes
    command: ["python", "-m", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8005", "--reload"]
    volumes:
      - ./services/trading-engine/logs:/app/logs
      - ./services/trading-engine/app:/app/app  # Dev: source code mount
    restart: unless-stopped
    networks:
      - crypto-bot-network
    depends_on:
      bybit-connector:
        condition: service_healthy
      technical-analysis:
        condition: service_healthy
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:8005/health"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 40s
    deploy:
      resources:
        limits:
          cpus: '1.0'
          memory: 1G
        reservations:
          cpus: '0.25'
          memory: 256M

  # Notification Service - Alerts and notifications
  notification-service:
    build:
      context: ./services/notification-service
      dockerfile: Dockerfile
    container_name: crypto-bot-notification
    ports:
      - "8006:8006"
    env_file:
      - ./services/notification-service/.env
    environment:
      - DEBUG=false
      - LOG_LEVEL=INFO
      - TIMESCALE_HOST=crypto-bot-timescaledb
      - POSTGRES_HOST=crypto-bot-postgres
      - REDIS_HOST=crypto-bot-redis
      - RABBITMQ_HOST=crypto-bot-rabbitmq
    volumes:
      - ./services/notification-service/logs:/app/logs
    restart: unless-stopped
    networks:
      - crypto-bot-network
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:8006/health"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 40s
    deploy:
      resources:
        limits:
          cpus: '0.5'
          memory: 256M
        reservations:
          cpus: '0.1'
          memory: 64M

  # ML Prediction Service - LSTM price forecasting
  ml-prediction:
    build:
      context: ./services/ml-prediction-service
      dockerfile: Dockerfile
    container_name: crypto-bot-ml-prediction
    ports:
      - "8007:8007"
    environment:
      - DEBUG=false
      - LOG_LEVEL=INFO
      - MARKET_DATA_URL=http://market-data:8002
    volumes:
      - ./services/ml-prediction-service/logs:/app/logs
      - ./services/ml-prediction-service/models:/app/models
    restart: unless-stopped
    networks:
      - crypto-bot-network
    depends_on:
      market-data:
        condition: service_healthy
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:8007/health"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 40s
    deploy:
      resources:
        limits:
          cpus: '2.0'
          memory: 2G
        reservations:
          cpus: '0.5'
          memory: 512M

  # Sentiment Analysis Service - News and social sentiment
  sentiment-analysis:
    build:
      context: ./services/sentiment-analysis-service
      dockerfile: Dockerfile
    container_name: crypto-bot-sentiment
    ports:
      - "8008:8008"
    environment:
      - DEBUG=false
      - LOG_LEVEL=INFO
      - NEWS_API_KEY=${NEWS_API_KEY:-}
      - TWITTER_BEARER_TOKEN=${TWITTER_BEARER_TOKEN:-}
    volumes:
      - ./services/sentiment-analysis-service/logs:/app/logs
    restart: unless-stopped
    networks:
      - crypto-bot-network
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:8008/health"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 40s
    deploy:
      resources:
        limits:
          cpus: '2.0'
          memory: 2G
        reservations:
          cpus: '0.5'
          memory: 512M

  # Risk Metrics Service - Risk analysis and metrics
  risk-metrics:
    build:
      context: ./services/risk-metrics-service
      dockerfile: Dockerfile
    container_name: crypto-bot-risk-metrics
    ports:
      - "8009:8009"
    environment:
      - DEBUG=false
      - LOG_LEVEL=INFO
      - TRADING_ENGINE_URL=http://trading-engine:8005
      - PORTFOLIO_MANAGER_URL=http://portfolio-manager:8003
      - REDIS_HOST=crypto-bot-redis
      - REDIS_PORT=6379
      - REDIS_PASSWORD=redis_dev_password
    volumes:
      - ./services/risk-metrics-service/logs:/app/logs
    restart: unless-stopped
    networks:
      - crypto-bot-network
    depends_on:
      trading-engine:
        condition: service_healthy
      portfolio-manager:
        condition: service_healthy
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:8009/health"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 40s
    deploy:
      resources:
        limits:
          cpus: '0.5'
          memory: 512M
        reservations:
          cpus: '0.1'
          memory: 128M

  # ===========================================================================
  # MONITORING SERVICES
  # ===========================================================================

  # Prometheus - Metrics collection and alerting
  prometheus:
    image: prom/prometheus:v2.47.0
    container_name: crypto-bot-prometheus
    ports:
      - "9090:9090"
    command:
      - '--config.file=/etc/prometheus/prometheus.yml'
      - '--storage.tsdb.path=/prometheus'
      - '--storage.tsdb.retention.time=15d'
      - '--web.enable-lifecycle'
      - '--web.enable-admin-api'
    volumes:
      - ./infrastructure/monitoring/prometheus.yml:/etc/prometheus/prometheus.yml:ro
      - ./infrastructure/monitoring/alerts.yml:/etc/prometheus/alerts.yml:ro
      - prometheus_data:/prometheus
    networks:
      - crypto-bot-network
    restart: unless-stopped
    healthcheck:
      test: ["CMD", "wget", "-q", "--spider", "http://localhost:9090/-/healthy"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 30s
    deploy:
      resources:
        limits:
          cpus: '0.5'
          memory: 512M
        reservations:
          cpus: '0.1'
          memory: 128M

  # Grafana - Metrics visualization and dashboards
  grafana:
    image: grafana/grafana:10.2.0
    container_name: crypto-bot-grafana
    ports:
      - "3001:3000"
    environment:
      - GF_SECURITY_ADMIN_USER=${GRAFANA_USER:-admin}
      - GF_SECURITY_ADMIN_PASSWORD=${GRAFANA_PASSWORD:-admin}
      - GF_USERS_ALLOW_SIGN_UP=false
      - GF_SERVER_ROOT_URL=${GRAFANA_ROOT_URL:-http://localhost:3001}
      - GF_INSTALL_PLUGINS=grafana-clock-panel,grafana-piechart-panel
    volumes:
      - grafana_data:/var/lib/grafana
      - ./infrastructure/monitoring/grafana/provisioning:/etc/grafana/provisioning:ro
      - ./infrastructure/monitoring/grafana/dashboards:/var/lib/grafana/dashboards:ro
    networks:
      - crypto-bot-network
    depends_on:
      prometheus:
        condition: service_healthy
    restart: unless-stopped
    healthcheck:
      test: ["CMD", "wget", "-q", "--spider", "http://localhost:3000/api/health"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 60s
    deploy:
      resources:
        limits:
          cpus: '0.5'
          memory: 512M
        reservations:
          cpus: '0.1'
          memory: 128M

# ===========================================================================
# NETWORKS - Simplified configuration (no external dependency)
# ===========================================================================
networks:
  crypto-bot-network:
    name: crypto-bot-network
    driver: bridge
    ipam:
      config:
        - subnet: 172.28.0.0/16
  # infrastructure-network:
  #   external: true
  #   name: infrastructure_crypto-bot-network

# ===========================================================================
# VOLUMES
# ===========================================================================
volumes:
  logs:
    name: crypto-bot-logs
  prometheus_data:
    name: crypto-bot-prometheus-data
  grafana_data:
    name: crypto-bot-grafana-data
