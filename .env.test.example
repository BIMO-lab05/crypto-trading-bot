# Test-mode environment overrides for tests/integration/
# Copy to .env.test (gitignored) and fill in TEST_TELEGRAM_BOT_TOKEN / TEST_TELEGRAM_CHAT_ID for live-mode
# Local default uses NOTIFICATION_TEST_MODE=record; flip to live only with a real test bot

MARKET_DATA_SOURCE=tape
PAPER_TRADING_MODE=true
TRADING_MODE=PAPER
AUTO_TRADING_ENABLED=true
ENABLE_ML_PREDICTIONS=false
ENABLE_SENTIMENT_ANALYSIS=false

# Notification verification (CD-01)
# - record (default, local): write would-be sends to tests/.notifications.log
# - live   (CI):              send to dedicated test Telegram bot in private channel; assert via getUpdates
NOTIFICATION_TEST_MODE=record
NOTIFICATION_RECORD_PATH=tests/.notifications.log

# Live-mode credentials -- leave blank in committed file. Filled in only via:
#   - GitHub Actions encrypted secrets (CI workflow uses secrets.TEST_TELEGRAM_BOT_TOKEN)
#   - .env.test (gitignored, local override)
TEST_TELEGRAM_BOT_TOKEN=
TEST_TELEGRAM_CHAT_ID=
