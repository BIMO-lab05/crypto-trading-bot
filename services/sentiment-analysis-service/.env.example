# Sentiment Analysis Service - Environment Variables
# Copy this file to .env and fill in your actual API keys

# Service Configuration
ENVIRONMENT=development
SERVICE_PORT=8008

# ===== External API Keys =====

# NewsAPI (https://newsapi.org/)
# Free tier: 100 requests/day
# Developer tier: 250 requests/day ($49/month)
# Business tier: 1000 requests/day ($499/month)
# Get your key: https://newsapi.org/register
NEWS_API_KEY=your_newsapi_key_here

# Twitter API v2 (https://developer.twitter.com/)
# Essential access: 500k tweets/month (free)
# Elevated access: 2M tweets/month (free, requires approval)
# Get your bearer token: https://developer.twitter.com/en/portal/dashboard
TWITTER_BEARER_TOKEN=your_twitter_bearer_token_here

# Reddit API (Future integration - optional)
# Get credentials: https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=your_reddit_client_id_here
REDDIT_CLIENT_SECRET=your_reddit_client_secret_here

# ===== Sentiment Analysis Settings =====

# Cache duration in minutes (how long to cache sentiment scores)
SENTIMENT_CACHE_TTL_MINUTES=15

# Minimum number of news articles required for sentiment calculation
MIN_NEWS_COUNT=3

# How many hours back to analyze sentiment
SENTIMENT_LOOKBACK_HOURS=24

# ===== Scoring Weights =====
# These should sum to 1.0 for proper weighted average

# Weight for news sentiment in combined score
NEWS_WEIGHT=0.4

# Weight for social media sentiment in combined score
SOCIAL_WEIGHT=0.3

# Weight for technical indicators in combined score
TECHNICAL_WEIGHT=0.3

# ===== Sentiment Thresholds =====

# Sentiment score above this is considered bullish (0.0 to 1.0)
BULLISH_THRESHOLD=0.6

# Sentiment score below this is considered bearish (0.0 to 1.0)
BEARISH_THRESHOLD=0.4

# ===== Notes =====
# - Leave API keys empty to use mock data (useful for testing)
# - Mock data provides graceful degradation when APIs are unavailable
# - Rate limits are automatically handled with caching and exponential backoff
# - See README.md for detailed setup instructions
