# Risk & Metrics Service - Environment Variables
# Copy this file to .env and update the values for production

# Service Configuration
SERVICE_NAME=risk-metrics-service
SERVICE_PORT=8007
SERVICE_HOST=0.0.0.0
LOG_LEVEL=INFO

# External Services
PORTFOLIO_MANAGER_URL=http://localhost:8006
MARKET_DATA_URL=http://localhost:8003

# Security
# IMPORTANT: Change this in production!
ADMIN_API_KEY=dev-admin-key-change-in-production
# Comma-separated list of allowed origins for CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Risk Management Parameters
MAX_PORTFOLIO_RISK=0.05  # 5% max portfolio risk
MAX_POSITION_SIZE=0.02   # 2% max per position
MAX_DRAWDOWN_THRESHOLD=0.10  # 10% max drawdown before alert
MAX_DAILY_LOSS=0.05      # 5% daily loss limit
MAX_EXPOSURE=0.20        # 20% max total exposure

# Performance Metrics
RISK_FREE_RATE=0.04      # 4% annual risk-free rate
TARGET_SHARPE_RATIO=1.5  # Target Sharpe ratio
LOOKBACK_PERIOD_DAYS=30  # Lookback period for metrics

# Circuit Breakers
ENABLE_CIRCUIT_BREAKER=True
CIRCUIT_BREAKER_COOLDOWN=3600  # 1 hour cooldown in seconds

# Database (optional)
DATABASE_URL=
