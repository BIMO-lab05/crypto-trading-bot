[run]
source = app
omit =
    */tests/*
    */venv/*
    */__pycache__/*
    app/backtesting.py
    app/backtest_models.py

[report]
precision = 2
show_missing = True
skip_covered = False
exclude_lines =
    pragma: no cover
    def __repr__
    raise AssertionError
    raise NotImplementedError
    if __name__ == .__main__.:
    if TYPE_CHECKING:
    @abstractmethod
