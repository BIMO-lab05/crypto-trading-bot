# API Gateway Environment Configuration
# Copy this file to .env and set appropriate values

# Service Configuration
SERVICE_NAME=api-gateway
SERVICE_PORT=8000
LOG_LEVEL=INFO

# Backend Service URLs
BYBIT_CONNECTOR_URL=http://localhost:8002
MARKET_DATA_URL=http://localhost:8003
TECHNICAL_ANALYSIS_URL=http://localhost:8004
TRADING_ENGINE_URL=http://localhost:8005
PORTFOLIO_MANAGER_URL=http://localhost:8006
RISK_METRICS_URL=http://localhost:8007

# Security (REQUIRED)
# Generate a secure 32+ character secret key
# Example: openssl rand -hex 32
JWT_SECRET_KEY=your-super-secret-jwt-key-minimum-32-characters-long-please
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BURST=10

# Caching
CACHE_ENABLED=true
CACHE_TTL_SECONDS=60
REDIS_URL=redis://localhost:6379

# CORS Configuration
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# API Documentation
API_TITLE=Crypto Trading Bot API Gateway
API_VERSION=1.0.0
API_DESCRIPTION=Unified API Gateway for Crypto Trading Bot Services
