# ==========================================
# NOTIFICATION SERVICE CONFIGURATION
# ==========================================
# Copy this file to .env and fill in your details

# Service Settings
SERVICE_NAME=notification-service
SERVICE_VERSION=2.0.0
HOST=0.0.0.0
PORT=8007

# Database (for alert storage - optional)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/crypto_bot

# Redis (for rate limiting - optional)
REDIS_URL=redis://localhost:6379/0

# ==========================================
# EMAIL CONFIGURATION
# ==========================================
# Set to true to enable email notifications
EMAIL_ENABLED=false

# Gmail SMTP settings (or use your email provider)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# Your Gmail address
SMTP_USERNAME=your.email@gmail.com

# Gmail App Password (NOT your regular password!)
# Get it from: https://myaccount.google.com/apppasswords
SMTP_PASSWORD=your_app_password_here

# Sender email (usually same as SMTP_USERNAME)
EMAIL_FROM=your.email@gmail.com

# Recipient email(s) - comma separated for multiple
EMAIL_TO=your.email@gmail.com

# Batch email interval for LOW priority (seconds)
EMAIL_BATCH_INTERVAL=300

# ==========================================
# TELEGRAM CONFIGURATION
# ==========================================
# Set to true to enable Telegram notifications
TELEGRAM_ENABLED=false

# Get from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz

# Your Telegram Chat ID
# Get from: https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_CHAT_ID=123456789

# Rate limiting
TELEGRAM_RATE_LIMIT=20
TELEGRAM_RETRY_ATTEMPTS=3
TELEGRAM_RETRY_DELAY=1.0

# ==========================================
# SLACK CONFIGURATION (NEW)
# ==========================================
# Set to true to enable Slack notifications
SLACK_ENABLED=false

# Slack Incoming Webhook URL
# Get from: https://api.slack.com/apps -> Incoming Webhooks
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T00000000/B00000000/XXXXXXXXXXXXXXXXXXXXXXXX

# Channel for critical alerts
SLACK_CHANNEL_CRITICAL=#trading-critical

# Channel for general alerts
SLACK_CHANNEL_ALERTS=#trading-alerts

# Slack Bot Token (optional - for interactive features)
SLACK_BOT_TOKEN=xoxb-your-bot-token

# ==========================================
# SMS CONFIGURATION (NEW - Twilio)
# ==========================================
# Set to true to enable SMS notifications (CRITICAL alerts only)
SMS_ENABLED=false

# Twilio Account SID
# Get from: https://console.twilio.com
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Twilio Auth Token
TWILIO_AUTH_TOKEN=your_auth_token_here

# Twilio Phone Number (with country code)
TWILIO_PHONE_NUMBER=+15551234567

# SMS Recipient Numbers (comma separated, with country code)
SMS_RECIPIENT_NUMBERS=+15559876543,+15551112222

# ==========================================
# ALERT ROUTING CONFIGURATION
# ==========================================
# Define which channels receive alerts by severity level
# Options: telegram, email, slack, sms, dashboard

# CRITICAL: System failures, large losses, emergency stops
CRITICAL_CHANNELS=telegram,email,slack

# HIGH: Risk limit breaches, significant events
HIGH_CHANNELS=telegram,email

# MEDIUM: Trade completions, position changes
MEDIUM_CHANNELS=telegram

# LOW: Daily summaries, informational
LOW_CHANNELS=email

# INFO: Routine operations
INFO_CHANNELS=dashboard

# ==========================================
# ALERT SUPPRESSION SETTINGS
# ==========================================

# Deduplicate identical alerts within this window (seconds)
DEDUP_WINDOW_SECONDS=300

# Max alerts of same type per hour
THROTTLE_MAX_PER_HOUR=3

# Quiet hours - mute LOW/INFO during these times
QUIET_HOURS_ENABLED=false
QUIET_HOURS_START=22:00
QUIET_HOURS_END=08:00
QUIET_HOURS_TIMEZONE=UTC

# ==========================================
# ESCALATION SETTINGS
# ==========================================

# Seconds to wait for CRITICAL alert acknowledgment before SMS
CRITICAL_ACK_TIMEOUT=300

# Seconds of system downtime before emergency escalation
SYSTEM_DOWN_ESCALATION=600

# Emergency contact phone number
EMERGENCY_CONTACT=+15559999999

# ==========================================
# LEGACY ALERT SETTINGS (Backward Compatibility)
# ==========================================
# Which events should trigger alerts

# Alert on every trade execution
ALERT_ON_TRADE=true

# Alert on profitable trades
ALERT_ON_PROFIT=true

# Alert on losing trades
ALERT_ON_LOSS=true

# Alert when daily loss limit is reached (RECOMMENDED!)
ALERT_ON_DAILY_LIMIT=true

# Alert on system errors
ALERT_ON_ERROR=true

# Alert when bot starts
ALERT_ON_STARTUP=true

# ==========================================
# ALERT THRESHOLDS
# ==========================================
# Minimum profit/loss to trigger alerts (in USD)

# Only alert if profit is greater than this
MIN_PROFIT_ALERT=10.0

# Only alert if loss is greater than this
MIN_LOSS_ALERT=10.0
