# Bybit Connector Service - Environment Configuration
# Copy to .env and fill in your values

# Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=true

# Bybit API - GET FROM TESTNET: https://testnet.bybit.com/
BYBIT_API_KEY=your_bybit_api_key_here
BYBIT_API_SECRET=your_bybit_api_secret_here
BYBIT_TESTNET=true
BYBIT_RECV_WINDOW=5000

# Service Configuration
SERVICE_NAME=bybit-connector
SERVICE_PORT=8002
SERVICE_HOST=0.0.0.0

# Redis (from docker-compose)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change_this_secure_password
REDIS_DB=0

# RabbitMQ (from docker-compose)
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=cryptobot
RABBITMQ_PASSWORD=change_this_secure_password
RABBITMQ_VHOST=cryptobot

# Circuit Breaker
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RECOVERY_TIMEOUT=60

# Retry Configuration
MAX_RETRY_ATTEMPTS=3
RETRY_BASE_DELAY=1.0
RETRY_MAX_DELAY=60.0

# Rate Limiting
RATE_LIMIT_REQUESTS_PER_SECOND=10
RATE_LIMIT_BURST=20

# Monitoring
ENABLE_METRICS=true
METRICS_PORT=9090
