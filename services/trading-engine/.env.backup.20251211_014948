# Service Configuration
SERVICE_NAME=trading-engine
SERVICE_HOST=0.0.0.0
SERVICE_PORT=8005
DEBUG=true
LOG_LEVEL=INFO

# Service URLs
TECHNICAL_ANALYSIS_URL=http://localhost:8004
BYBIT_CONNECTOR_URL=http://localhost:8002
PORTFOLIO_MANAGER_URL=http://localhost:8003
ML_PREDICTION_URL=http://localhost:8007
SENTIMENT_ANALYSIS_URL=http://localhost:8008
NOTIFICATION_SERVICE_URL=http://notification-service:8006

# Notification Settings - ENABLED 2025-12-01
ENABLE_NOTIFICATIONS=true
NOTIFY_ON_TRADE_OPEN=true
NOTIFY_ON_TRADE_CLOSE=true
NOTIFY_ON_DAILY_SUMMARY=true

# Phase 3 ML Integration - DISABLED 2025-12-03
# Disabled Enhanced Aggregator to allow Phase 1 signals to execute
# Phase 1 (Technical indicators only) now controls all trades
ENABLE_ML_PREDICTIONS=false
ENABLE_SENTIMENT_ANALYSIS=false
ENABLE_MULTI_TIMEFRAME=false

# Multi-Timeframe Alignment (2025-12-01)
# DISABLED - Phase 3 is turned off, using Phase 1 only
MTF_REQUIRE_ALIGNMENT=false
MTF_MIN_ALIGNMENT_SCORE=60.0

# Trading Configuration
TRADING_MODE=PAPER
AUTO_TRADING_ENABLED=true
DEFAULT_STRATEGY=consensus
DEFAULT_SYMBOL=BTCUSDT
DEFAULT_INTERVAL=60

# Risk Management - OPTIMIZED 2025-12-01
# Target: 2:1 Risk/Reward ratio with 56% win rate
# Math: EV = 0.565 × 3% - 0.435 × 1.5% = +1.04% per trade
MAX_POSITION_SIZE_PCT=2.0
MAX_DAILY_LOSS_PCT=5.0
MAX_TOTAL_EXPOSURE_PCT=80.0
DEFAULT_STOP_LOSS_PCT=1.5
DEFAULT_TAKE_PROFIT_PCT=3.0

# Signal Thresholds - OPTIMIZED (2025-12-04)
# RAISED from 0.11 to 0.55 - Pattern analysis shows 41% WR too low
# Target: 52%+ win rate by filtering weak signals
# Note: This overrides strategy MIN_CONFIDENCE via environment
MIN_SIGNAL_CONFIDENCE=0.55
MIN_CONSENSUS_INDICATORS=3

# Database Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=trading_engine
POSTGRES_USER=cryptobot
POSTGRES_PASSWORD=cryptobot_dev_password

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=2
REDIS_PASSWORD=redis_dev_password

# Paper Trading
PAPER_INITIAL_BALANCE=10000.0
PAPER_COMMISSION_PCT=0.1

# Database connection (for shared/database module)
DB_HOST=crypto-bot-postgres
