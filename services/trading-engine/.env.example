# Environment Configuration Template
# Copy this file to .env and fill in your actual values
# NEVER commit .env files to version control!

# Service Configuration
SERVICE_NAME=trading-engine
SERVICE_HOST=0.0.0.0
SERVICE_PORT=8005
DEBUG=false  # Set to false in production!
LOG_LEVEL=INFO  # Options: DEBUG, INFO, WARNING, ERROR, CRITICAL

# Service URLs
TECHNICAL_ANALYSIS_URL=http://localhost:8004
BYBIT_CONNECTOR_URL=http://localhost:8002
PORTFOLIO_MANAGER_URL=http://localhost:8003

# Trading Configuration
TRADING_MODE=PAPER  # Options: PAPER, LIVE - Start with PAPER!
AUTO_TRADING_ENABLED=false  # Enable automated trading (use with caution!)
DEFAULT_STRATEGY=consensus
DEFAULT_SYMBOL=BTCUSDT
DEFAULT_INTERVAL=60

# Risk Management (Percentage values)
MAX_POSITION_SIZE_PCT=2.0  # Maximum position size as % of capital (0.1-10.0)
MAX_DAILY_LOSS_PCT=5.0  # Maximum daily loss as % of capital (1.0-20.0)
MAX_TOTAL_EXPOSURE_PCT=20.0  # Maximum total exposure as % of capital (5.0-100.0)
DEFAULT_STOP_LOSS_PCT=3.0  # Default stop loss as % from entry (0.5-10.0)
DEFAULT_TAKE_PROFIT_PCT=6.0  # Default take profit as % from entry (1.0-50.0)

# Signal Thresholds
MIN_SIGNAL_CONFIDENCE=0.6  # Minimum signal confidence to trade (0.0-1.0)
MIN_CONSENSUS_INDICATORS=3  # Minimum indicators in agreement (1-10)

# Database Configuration - PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=trading_engine
POSTGRES_USER=your_postgres_user
POSTGRES_PASSWORD=your_secure_postgres_password_here  # CHANGE THIS!

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_DB=2
REDIS_PASSWORD=your_secure_redis_password_here  # CHANGE THIS!

# Paper Trading Configuration
PAPER_INITIAL_BALANCE=100.0  # Initial balance for paper trading
PAPER_COMMISSION_PCT=0.1  # Commission percentage for paper trading

# Shared Database Configuration (for shared/database module)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cryptobot
DB_USER=your_db_user
DB_PASSWORD=your_secure_db_password_here  # CHANGE THIS!

# CORS Configuration (Frontend integration)
# CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# Optional: Monitoring and Alerting
# SENTRY_DSN=your_sentry_dsn_here
# SLACK_WEBHOOK_URL=your_slack_webhook_here
# EMAIL_ALERT_ENABLED=false
# EMAIL_SMTP_SERVER=smtp.gmail.com
# EMAIL_SMTP_PORT=587
# EMAIL_FROM=alerts@yourdomain.com
# EMAIL_TO=admin@yourdomain.com
# EMAIL_PASSWORD=your_email_password_here

# Optional: API Keys for External Services
# BYBIT_API_KEY=your_bybit_api_key_here  # KEEP SECRET!
# BYBIT_API_SECRET=your_bybit_api_secret_here  # KEEP SECRET!
# BYBIT_TESTNET=true  # Use testnet for testing

# Optional: Rate Limiting
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_REQUESTS=100
# RATE_LIMIT_PERIOD=60

# Optional: Feature Flags
# ENABLE_MULTI_TIMEFRAME=true
# ENABLE_ML_PREDICTIONS=false
# ENABLE_SENTIMENT_ANALYSIS=false
