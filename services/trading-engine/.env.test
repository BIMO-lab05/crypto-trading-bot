# Test Environment Configuration
# Purpose: PostgreSQL connection settings for integration tests

# Test Database Configuration
# Use separate test database to avoid polluting production/development data
TEST_DB_HOST=localhost
TEST_DB_PORT=5432
TEST_DB_NAME=cryptobot_test
TEST_DB_USER=cryptobot
TEST_DB_PASSWORD=cryptobot_dev_password

# Database Connection Pool
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600

# Logging
DB_ECHO=false  # Set to true for SQL query debugging

# Service Configuration (for integration tests)
SERVICE_NAME=trading-engine-test
SERVICE_PORT=8001
ENVIRONMENT=test

# Redis (if needed for tests)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=1  # Use different DB for tests

# RabbitMQ (if needed for tests)
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
