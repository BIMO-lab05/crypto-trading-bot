# =============================================================================
# SQZMOM PAPER TRADING CONFIGURATION
# Purpose: Paper trading validation environment for SQZMOM strategy
# Created: 2025-12-12
# Mode: PAPER TRADING ONLY (NO LIVE TRADES)
# =============================================================================

# Service Configuration
SERVICE_NAME=trading-engine
SERVICE_HOST=0.0.0.0
SERVICE_PORT=8005
DEBUG=true
LOG_LEVEL=INFO

# Service URLs
TECHNICAL_ANALYSIS_URL=http://localhost:8004
BYBIT_CONNECTOR_URL=http://localhost:8002
PORTFOLIO_MANAGER_URL=http://localhost:8003
ML_PREDICTION_URL=http://localhost:8007
SENTIMENT_ANALYSIS_URL=http://localhost:8008
NOTIFICATION_SERVICE_URL=http://localhost:8006

# =============================================================================
# TRADING MODE - CRITICAL SETTINGS
# =============================================================================
# PAPER MODE ENFORCED - DO NOT CHANGE TO LIVE WITHOUT APPROVAL
TRADING_MODE=PAPER
AUTO_TRADING_ENABLED=true

# =============================================================================
# SQZMOM STRATEGY CONFIGURATION
# =============================================================================
# Based on Dec 6 analysis - TOP 7 PERFORMERS ONLY
DEFAULT_STRATEGY=sqzmom

# Strategy Enablement Flags
SQZMOM_ENABLED=true
STAT_ARB_ENABLED=false
GRID_TRADING_ENABLED=false
TREND_FOLLOWING_ENABLED=false
MOMENTUM_ENABLED=false
CONSENSUS_STRATEGY_ENABLED=false

# =============================================================================
# PROFITABLE TRADING SYMBOLS - DEC 6 ANALYSIS
# =============================================================================
# TOP 7 PERFORMERS (profitable based on backtesting and Dec 6 analysis):
# - BNBUSDT: Best performer, consistent profits ✅
# - SOLUSDT: Strong momentum, good signals ✅
# - ADAUSDT: Stable performer ✅
# - ARBUSDT: Arbitrum - Good volatility ✅
# - OPUSDT: Optimism - Good momentum ✅
# - POLUSDT: Polygon - Consistent ✅
# - SUIUSDT: SUI - New performer ✅
#
# EXCLUDED SYMBOLS (losing performance - Dec 6 analysis):
# - XRPUSDT: -$39.73 loss, 25% WR ❌ NEVER re-enable
# - ETHUSDT: -$23.65 loss, 42.9% WR ❌
# - BTCUSDT: -$10.59 loss, 40% WR ❌
#
# NOTE: Use JSON array format for List fields
TRADING_SYMBOLS=["BNBUSDT","SOLUSDT","ADAUSDT","ARBUSDT","OPUSDT","POLUSDT","SUIUSDT"]
DEFAULT_SYMBOL=BNBUSDT
DEFAULT_INTERVAL=60

# =============================================================================
# SYMBOL ALLOCATION WEIGHTS - PERFORMANCE-BASED
# =============================================================================
# Allocation Strategy (equal-weighted for validation):
# - Each of 7 symbols gets ~14.3% allocation
# After 2-week validation, adjust based on performance
SYMBOL_ALLOCATIONS={"BNBUSDT": 0.16, "SOLUSDT": 0.16, "ADAUSDT": 0.14, "ARBUSDT": 0.14, "OPUSDT": 0.14, "POLUSDT": 0.13, "SUIUSDT": 0.13}

# =============================================================================
# RISK MANAGEMENT - CONSERVATIVE FOR PAPER TESTING
# =============================================================================
# Max 2% risk per trade (as per project requirements)
MAX_POSITION_SIZE_PCT=2.0

# 5% portfolio loss emergency stop (as per project requirements)
MAX_DAILY_LOSS_PCT=5.0

# Total exposure limit
MAX_TOTAL_EXPOSURE_PCT=70.0

# Stop loss and take profit
DEFAULT_STOP_LOSS_PCT=2.0
DEFAULT_TAKE_PROFIT_PCT=4.0

# =============================================================================
# DYNAMIC RISK BUDGETING - ENABLED
# =============================================================================
# Enable dynamic risk adjustment based on performance
ENABLE_DYNAMIC_RISK_BUDGETING=true
RISK_BUDGET_INITIAL=10000.0
RISK_BUDGET_DAILY_RESET=true
RISK_SCALING_FACTOR=0.5
MAX_RISK_MULTIPLIER=2.0
MIN_RISK_MULTIPLIER=0.25

# =============================================================================
# SIGNAL THRESHOLDS
# =============================================================================
MIN_SIGNAL_CONFIDENCE=0.60
MIN_CONSENSUS_INDICATORS=2

# =============================================================================
# PAPER TRADING CONFIGURATION
# =============================================================================
PAPER_INITIAL_BALANCE=10000.0
PAPER_COMMISSION_PCT=0.1

# =============================================================================
# NOTIFICATION SETTINGS
# =============================================================================
ENABLE_NOTIFICATIONS=true
NOTIFY_ON_TRADE_OPEN=true
NOTIFY_ON_TRADE_CLOSE=true
NOTIFY_ON_DAILY_SUMMARY=true

# =============================================================================
# ML/SENTIMENT INTEGRATION - DISABLED FOR SQZMOM ISOLATION
# =============================================================================
# Keep ML disabled to isolate SQZMOM performance
ENABLE_ML_PREDICTIONS=false
ENABLE_SENTIMENT_ANALYSIS=false
ENABLE_MULTI_TIMEFRAME=false
MTF_REQUIRE_ALIGNMENT=false
MTF_MIN_ALIGNMENT_SCORE=60.0

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=trading_engine
POSTGRES_USER=cryptobot
POSTGRES_PASSWORD=cryptobot_dev_password

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=2
REDIS_PASSWORD=redis_dev_password

# =============================================================================
# MONITORING AND LOGGING
# =============================================================================
ENABLE_METRICS=true
METRICS_PORT=9090
LOG_TRADES_TO_FILE=true
LOG_FILE_PATH=/mnt/d/Bimo_max/crypto-trading-bot/services/trading-engine/logs/sqzmom_paper.log

# =============================================================================
# TIME-BASED TRADING FILTERS
# =============================================================================
ENABLE_TIME_FILTERS=true
TRADING_START_HOUR_UTC=8
TRADING_END_HOUR_UTC=21
AVOID_WEEKENDS=true

# =============================================================================
# TRADE FREQUENCY LIMITS
# =============================================================================
MAX_DAILY_TRADES=50
CHECK_FREQUENCY_SECONDS=30
ALLOW_SAME_SYMBOL_REENTRY=true
MIN_TIME_BETWEEN_TRADES_SAME_SYMBOL=60
