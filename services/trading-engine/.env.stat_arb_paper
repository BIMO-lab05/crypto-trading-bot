# =============================================================================
# STATISTICAL ARBITRAGE - PAPER TRADING CONFIGURATION
# Purpose: Safe deployment environment for Phase 2.2 Stat Arb strategies
# Created: 2025-12-11
# Mode: PAPER TRADING ONLY (NO LIVE TRADES)
# =============================================================================

# Service Configuration
SERVICE_NAME=trading-engine
SERVICE_HOST=0.0.0.0
SERVICE_PORT=8005
DEBUG=true
LOG_LEVEL=INFO

# Service URLs
TECHNICAL_ANALYSIS_URL=http://localhost:8004
BYBIT_CONNECTOR_URL=http://localhost:8002
PORTFOLIO_MANAGER_URL=http://localhost:8003
ML_PREDICTION_URL=http://localhost:8007
SENTIMENT_ANALYSIS_URL=http://localhost:8008
NOTIFICATION_SERVICE_URL=http://notification-service:8006

# =============================================================================
# TRADING MODE - CRITICAL SETTINGS
# =============================================================================
# PAPER MODE ENFORCED - DO NOT CHANGE TO LIVE WITHOUT APPROVAL
TRADING_MODE=PAPER
AUTO_TRADING_ENABLED=true

# =============================================================================
# STATISTICAL ARBITRAGE STRATEGY CONFIGURATION
# =============================================================================
# Enable ONLY Statistical Arbitrage strategies
# Disable all other strategies for isolated testing
DEFAULT_STRATEGY=statistical_arbitrage

# Strategy Enablement Flags
STAT_ARB_ENABLED=true
GRID_TRADING_ENABLED=false
TREND_FOLLOWING_ENABLED=false
MOMENTUM_ENABLED=false
CONSENSUS_STRATEGY_ENABLED=false

# =============================================================================
# STAT ARB SPECIFIC SETTINGS
# =============================================================================
# Capital Allocation Across Sub-Strategies
STAT_ARB_PAIRS_ALLOCATION=0.40
STAT_ARB_FUNDING_ALLOCATION=0.40
STAT_ARB_TRIANGULAR_ALLOCATION=0.20

# Pairs Trading Settings
PAIRS_ENTRY_THRESHOLD=2.0
PAIRS_EXIT_THRESHOLD=0.5
PAIRS_STOP_LOSS_Z=3.0
PAIRS_LOOKBACK_PERIOD=20
PAIRS_RECALIBRATION_HOURS=24

# Funding Rate Arbitrage Settings
FUNDING_MIN_RATE=0.0001
FUNDING_MAX_POSITION_SIZE=5000.0
FUNDING_HEDGE_RATIO=1.0

# Triangular Arbitrage Settings
TRIANGULAR_MIN_PROFIT_PCT=0.005
TRIANGULAR_MAX_LATENCY_MS=100.0
TRIANGULAR_EXECUTION_ENABLED=false

# =============================================================================
# PAPER TRADING CONFIGURATION
# =============================================================================
PAPER_INITIAL_BALANCE=10000.0
PAPER_COMMISSION_PCT=0.1

# =============================================================================
# TRADING SYMBOLS - CONSERVATIVE START
# =============================================================================
# Start with only BTCUSDT and ETHUSDT for Statistical Arbitrage
# These are the most liquid pairs with best cointegration potential
# NOTE: Use JSON array format for List fields
TRADING_SYMBOLS=["BTCUSDT","ETHUSDT"]
DEFAULT_SYMBOL=BTCUSDT
DEFAULT_INTERVAL=60

# Symbol Allocations for Stat Arb (JSON format for Dict fields)
SYMBOL_ALLOCATIONS={"BTCUSDT": 0.50, "ETHUSDT": 0.50}

# =============================================================================
# RISK MANAGEMENT - CONSERVATIVE FOR PAPER TESTING
# =============================================================================
# Max 5% position size per trade (conservative for testing)
MAX_POSITION_SIZE_PCT=5.0
MAX_DAILY_LOSS_PCT=5.0
MAX_TOTAL_EXPOSURE_PCT=60.0
DEFAULT_STOP_LOSS_PCT=2.0
DEFAULT_TAKE_PROFIT_PCT=4.0

# Signal Thresholds for Stat Arb
MIN_SIGNAL_CONFIDENCE=0.60
MIN_CONSENSUS_INDICATORS=2

# =============================================================================
# NOTIFICATION SETTINGS
# =============================================================================
ENABLE_NOTIFICATIONS=true
NOTIFY_ON_TRADE_OPEN=true
NOTIFY_ON_TRADE_CLOSE=true
NOTIFY_ON_DAILY_SUMMARY=true

# =============================================================================
# PHASE 3 ML INTEGRATION - DISABLED FOR STAT ARB TESTING
# =============================================================================
# Keep ML disabled to isolate Stat Arb performance
ENABLE_ML_PREDICTIONS=false
ENABLE_SENTIMENT_ANALYSIS=false
ENABLE_MULTI_TIMEFRAME=false
MTF_REQUIRE_ALIGNMENT=false
MTF_MIN_ALIGNMENT_SCORE=60.0

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=trading_engine
POSTGRES_USER=cryptobot
POSTGRES_PASSWORD=cryptobot_dev_password

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=2
REDIS_PASSWORD=redis_dev_password

# Shared Database Connection
DB_HOST=crypto-bot-postgres
DB_PORT=5432
DB_NAME=cryptobot
DB_USER=cryptobot
DB_PASSWORD=cryptobot_dev_password

# =============================================================================
# MONITORING AND LOGGING
# =============================================================================
ENABLE_METRICS=true
METRICS_PORT=9090
LOG_TRADES_TO_FILE=true
LOG_FILE_PATH=/mnt/d/Bimo_max/crypto-trading-bot/services/trading-engine/logs/stat_arb_paper.log

# =============================================================================
# TIME-BASED TRADING FILTERS
# =============================================================================
ENABLE_TIME_FILTERS=true
TRADING_START_HOUR_UTC=8
TRADING_END_HOUR_UTC=21
AVOID_WEEKENDS=true

# =============================================================================
# TRADE FREQUENCY LIMITS
# =============================================================================
MAX_DAILY_TRADES=20
CHECK_FREQUENCY_SECONDS=30
ALLOW_SAME_SYMBOL_REENTRY=true
MIN_TIME_BETWEEN_TRADES_SAME_SYMBOL=120
