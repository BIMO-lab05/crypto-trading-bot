# Market Data Service - Environment Variables Example
# Copy this file to .env and fill in your values

# Service Configuration
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=false
SERVICE_PORT=8003

# REQUIRED: Database Passwords (MUST BE SET)
TIMESCALE_PASSWORD=your_secure_timescaledb_password_here
POSTGRES_PASSWORD=your_secure_postgres_password_here
RABBITMQ_PASSWORD=your_secure_rabbitmq_password_here

# REQUIRED: API Authentication
# Comma-separated list of valid API keys for securing endpoints
API_KEYS=dev-key-12345,prod-key-67890

# TimescaleDB Configuration
TIMESCALE_HOST=localhost
TIMESCALE_PORT=5433
TIMESCALE_USER=cryptobot
TIMESCALE_DB=market_data

# PostgreSQL Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=cryptobot
POSTGRES_DB=cryptobot

# Redis Configuration (Optional password)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# RabbitMQ Configuration
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=cryptobot
RABBITMQ_VHOST=cryptobot

# Bybit Connector Service
BYBIT_CONNECTOR_URL=http://localhost:8002

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# Data Collection Settings - UPDATED: Added SOLUSDT, XRPUSDT, ADAUSDT, DOGEUSDT
DEFAULT_SYMBOLS=BTCUSDT,ETHUSDT,BNBUSDT,SOLUSDT,XRPUSDT,ADAUSDT,DOGEUSDT
DEFAULT_INTERVAL=60
FETCH_HISTORICAL_DAYS=30

# Cache TTL (seconds)
CACHE_TTL_TICKER=5
CACHE_TTL_KLINE=60
CACHE_TTL_ORDERBOOK=2

# Database Connection Pool
DB_POOL_MIN_SIZE=10
DB_POOL_MAX_SIZE=20
