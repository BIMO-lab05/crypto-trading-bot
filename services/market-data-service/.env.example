# Market Data Service - Environment Configuration

# Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=true

# Service
SERVICE_NAME=market-data-service
SERVICE_PORT=8003
SERVICE_HOST=0.0.0.0

# TimescaleDB (market data storage)
TIMESCALE_HOST=localhost
TIMESCALE_PORT=5433
TIMESCALE_USER=cryptobot
TIMESCALE_PASSWORD=change_this_secure_password
TIMESCALE_DB=market_data

# PostgreSQL (application data)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=cryptobot
POSTGRES_PASSWORD=change_this_secure_password
POSTGRES_DB=cryptobot

# Redis (caching)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change_this_secure_password
REDIS_DB=0

# RabbitMQ (messaging)
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=cryptobot
RABBITMQ_PASSWORD=change_this_secure_password
RABBITMQ_VHOST=cryptobot

# Bybit Connector Service
BYBIT_CONNECTOR_URL=http://localhost:8002

# Data Collection
DEFAULT_SYMBOLS=BTCUSDT,ETHUSDT
DEFAULT_INTERVAL=60
FETCH_HISTORICAL_DAYS=30

# Caching TTL (seconds)
CACHE_TTL_TICKER=5
CACHE_TTL_KLINE=60
CACHE_TTL_ORDERBOOK=2

# Database Connection Pool
DB_POOL_MIN_SIZE=10
DB_POOL_MAX_SIZE=20
